# Copy to .env and replace every "change-me" value. Never commit .env.
# Read by docker compose AND by the backend when run from the repository (spring.config.import).

# --- Backend runtime ---------------------------------------------------------
# dev = demo seed accounts + relaxed cookies over http://localhost; prod = hardened defaults.
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# --- MySQL -------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=homefix
DB_USERNAME=homefix
DB_PASSWORD=change-me-db-password
# Used only by the MySQL container for its root account.
MYSQL_ROOT_PASSWORD=change-me-root-password

# --- Authentication ----------------------------------------------------------
# HMAC-SHA256 signing key, at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48
JWT_ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=14d
# Must be true whenever the site is served over HTTPS (always in production).
COOKIE_SECURE=false
# Comma-separated browser origins allowed to call the API cross-origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173
AUTH_RATE_LIMIT_PER_MINUTE=10
REFRESH_RATE_LIMIT_PER_MINUTE=60

# --- API documentation -------------------------------------------------------
API_DOCS_ENABLED=true

# --- MinIO (S3-compatible object storage; used from Phase 3) ------------------
MINIO_ROOT_USER=homefix-minio
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Container ports (docker compose --profile app) ---------------------------
BACKEND_PORT=8080
FRONTEND_PORT=3000
